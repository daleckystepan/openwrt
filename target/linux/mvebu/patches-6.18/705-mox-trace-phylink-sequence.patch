 	/* power enable done in post_config */
 	mpcs->handle_irq = mv88e639x_sgmii_handle_irq;
 
-	return mv88e639x_sgmii_pcs_control_irq(mpcs, !!mpcs->irq);
+	err = mv88e639x_sgmii_pcs_control_irq(mpcs, !!mpcs->irq);
