 	 * is not forced down. Force the link down while we reconfigure the
 	 * interface mode.
@@ -900,6 +930,7 @@ static int mv88e6xxx_mac_prepare(struct phylink_config *config,
 		mv88e6xxx_reg_unlock(chip);
 	}
 
+	mv88e6xxx_mox_mac_trace(chip, port, "mac_prepare.after", mode, interface, err);
 	return err;
 }
 
