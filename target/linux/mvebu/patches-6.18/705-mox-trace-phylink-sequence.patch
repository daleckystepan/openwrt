 		return;
 	}
 
+	if (mpcs->port == 9 &&
+	    of_machine_is_compatible("cznic,turris-mox") &&
+	    of_device_is_compatible(mpcs->mdio.dev.parent->of_node,
+				     "marvell,turris-mox-mv88e6190") &&
+	    mpcs->mox_state_samples < 8 &&
+	    (!mpcs->mox_state_samples || mpcs->mox_last_bmsr != bmsr ||
+	     mpcs->mox_last_lpa != lpa || mpcs->mox_last_status != status)) {
+		mpcs->mox_state_samples++;
+		mpcs->mox_last_bmsr = bmsr;
+		mpcs->mox_last_lpa = lpa;
+		mpcs->mox_last_status = status;
+		dev_info(mpcs->mdio.dev.parent,
+			 "MOX switch PCS state: mode=%#x BMSR=%#x LPA=%#x PHY_STATUS=%#x\n",
+			 neg_mode, bmsr, lpa, status);
+	}
 	mv88e6xxx_pcs_decode_state(mpcs->mdio.dev.parent, bmsr, lpa, status,
 				   state);
 }
@@ -402,5 +466,7 @@ static int mv88e639x_sgmii_pcs_config(struct phylink_pcs *pcs,
 	int adv, err;
 
