 	if (mode != MLO_AN_PHY || !mv88e6xxx_phy_is_internal(chip, port)) {
@@ -924,6 +957,8 @@ static void mv88e6xxx_mac_config(struct phylink_config *config,
 err_unlock:
 	mv88e6xxx_reg_unlock(chip);
 
+	mv88e6xxx_mox_mac_trace(chip, port, "mac_config.after", mode,
+			       state->interface, err);
 	if (err && err != -EOPNOTSUPP)
 		dev_err(chip->dev, "p%d: failed to configure MAC/PCS\n", port);
 }
@@ -936,6 +971,8 @@ static int mv88e6xxx_mac_finish(struct phylink_config *config,
