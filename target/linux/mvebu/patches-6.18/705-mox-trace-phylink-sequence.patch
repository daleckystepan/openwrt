+static void mv88e639x_mox_trace(struct mv88e639x_pcs *mpcs,
+			       const char *event, phy_interface_t interface,
+			       int result)
+{
+	u16 bmcr, adv, status;
+	int err;
+
+	if (mpcs->port != 9 ||
+	    !of_machine_is_compatible("cznic,turris-mox") ||
+	    !of_device_is_compatible(mpcs->mdio.dev.parent->of_node,
+				     "marvell,turris-mox-mv88e6190"))
+		return;
+
+	err = mv88e639x_read(mpcs, MV88E6390_SGMII_BMCR, &bmcr);
+	if (!err)
+		err = mv88e639x_read(mpcs, MV88E6390_SGMII_ADVERTISE, &adv);
+	if (!err)
+		err = mv88e639x_read(mpcs, MV88E6390_SGMII_PHY_STATUS, &status);
+	if (err) {
+		dev_info(mpcs->mdio.dev.parent,
+			 "MOX sequence: %s interface=%s result=%d read_error=%d\n",
+			 event, phy_modes(interface), result, err);
+		return;
+	}
+	dev_info(mpcs->mdio.dev.parent,
+		 "MOX sequence: %s interface=%s result=%d BMCR=%#x ADV=%#x PHY_STATUS=%#x\n",
+		 event, phy_modes(interface), result, bmcr, adv, status);
+}
+
