--- a/drivers/net/dsa/mv88e6xxx/chip.c
+++ b/drivers/net/dsa/mv88e6xxx/chip.c
@@ -877,6 +877,34 @@
 	return pcs;
 }
 
+static void mv88e6xxx_mox_mac_trace(struct mv88e6xxx_chip *chip, int port,
+				   const char *event, unsigned int mode,
+				   phy_interface_t interface, int result)
+{
+	u16 status, mac;
+	int err;
+
+	if (port != 9 || !of_machine_is_compatible("cznic,turris-mox") ||
+	    !of_device_is_compatible(chip->dev->of_node,
+				     "marvell,turris-mox-mv88e6190"))
+		return;
+
+	mv88e6xxx_reg_lock(chip);
+	err = mv88e6xxx_port_read(chip, port, MV88E6XXX_PORT_STS, &status);
+	if (!err)
+		err = mv88e6xxx_port_read(chip, port, MV88E6XXX_PORT_MAC_CTL, &mac);
+	mv88e6xxx_reg_unlock(chip);
+	if (err) {
+		dev_info(chip->dev, "MOX sequence: switch_%s result=%d read_error=%d\n",
+			 event, result, err);
+		return;
+	}
+	dev_info(chip->dev,
+		 "MOX sequence: switch_%s interface=%s current=%s mode=%#x result=%d PORT_STATUS=%#x MAC_CTL=%#x\n",
+		 event, phy_modes(interface), phy_modes(chip->ports[port].interface),
+		 mode, result, status, mac);
+}
