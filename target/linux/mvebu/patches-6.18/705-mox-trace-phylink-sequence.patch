@@ -955,5 +992,6 @@ static int mv88e6xxx_mac_finish(struct phylink_config *config,
 
 	chip->ports[port].interface = interface;
 
+	mv88e6xxx_mox_mac_trace(chip, port, "mac_finish.after", mode, interface, err);
 	return err;
 }
