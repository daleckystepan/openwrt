 	mvreg_write(pp, MVNETA_GMAC_AUTONEG_CONFIG,
 		    gmac_an | MVNETA_GMAC_INBAND_RESTART_AN);
 	mvreg_write(pp, MVNETA_GMAC_AUTONEG_CONFIG,
@@ -4127,4 +4156,5 @@ static void mvneta_pcs_an_restart(struct phylink_pcs *pcs)
 		    gmac_an & ~MVNETA_GMAC_INBAND_RESTART_AN);
+	mvneta_mox_trace(pp, "pcs_an_restart.after", pp->phy_interface, 0, 0);
