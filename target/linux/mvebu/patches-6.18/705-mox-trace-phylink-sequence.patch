@@ -251,7 +285,12 @@ static int mv88e639x_sgmii_pcs_control_pwr(struct mv88e639x_pcs *mpcs,
 		mask = val = BMCR_PDOWN;
 	}
 
-	return mv88e639x_modify(mpcs, MV88E6390_SGMII_BMCR, mask, val);
+	mv88e639x_mox_trace(mpcs, enable ? "pcs_power_on.before" :
+			    "pcs_power_off.before", mpcs->interface, 0);
+	err = mv88e639x_modify(mpcs, MV88E6390_SGMII_BMCR, mask, val);
+	mv88e639x_mox_trace(mpcs, enable ? "pcs_power_on.after" :
+			    "pcs_power_off.after", mpcs->interface, err);
+	return err;
 }
 
 static int mv88e639x_sgmii_pcs_enable(struct phylink_pcs *pcs)
@@ -260,10 +299,14 @@ static int mv88e639x_sgmii_pcs_enable(struct phylink_pcs *pcs)
 {
