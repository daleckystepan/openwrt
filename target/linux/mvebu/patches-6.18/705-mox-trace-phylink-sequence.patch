+	mvneta_mox_trace(pp, "pcs_config.before", interface, neg_mode, 0);
+
 	mask = MVNETA_GMAC_INBAND_AN_ENABLE |
 	       MVNETA_GMAC_INBAND_RESTART_AN |
 	       MVNETA_GMAC_AN_SPEED_EN |
@@ -4110,6 +4134,9 @@ static int mvneta_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 			    neg_mode, old_an, an,
 			    mvreg_read(pp, MVNETA_GMAC_AUTONEG_CONFIG));
 
+	mvneta_mox_trace(pp, "pcs_config.after", interface, neg_mode,
+			 !!(changed & MVNETA_GMAC_ADVERT_SYM_FLOW_CTRL));
+
 	/* We are only interested in the advertisement bits changing */
 	return !!(changed & MVNETA_GMAC_ADVERT_SYM_FLOW_CTRL);
