 	return ret;
 }
 
@@ -4060,6 +4082,8 @@ static int mvneta_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
 	struct mvneta_port *pp = mvneta_pcs_to_port(pcs);
