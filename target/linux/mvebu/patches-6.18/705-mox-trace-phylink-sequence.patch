 	mv88e639x_sgmii_pcs_control_pwr(mpcs, false);
+	mv88e639x_mox_trace(mpcs, "pcs_disable.after", mpcs->interface, 0);
 }
 
@@ -285,6 +330,8 @@ static void mv88e639x_sgmii_pcs_pre_config(struct phylink_pcs *pcs,
