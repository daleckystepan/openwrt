Subject: [PATCH] net: trace MOX MAC and switch PCS configuration sequence

Trace the MOX CPU link callback order and register readbacks without
changing negotiation, power sequencing or callback return values.
Avoid extra BMSR and interrupt-status reads, which have latched state.
Log bounded switch PCS state changes using already-read values.
This is a temporary diagnostic, not a fix.

--- a/drivers/net/ethernet/marvell/mvneta.c
+++ b/drivers/net/ethernet/marvell/mvneta.c
@@ -3720,6 +3720,25 @@
 	return phy_power_on(pp->comphy);
 }
 
+static void mvneta_mox_trace(struct mvneta_port *pp, const char *event,
+			     phy_interface_t interface, unsigned int mode,
+			     int result)
+{
+	if (!of_machine_is_compatible("cznic,turris-mox") ||
+	    !phy_interface_mode_is_8023z(interface))
+		return;
+
+	netdev_info(pp->dev,
+		    "MOX sequence: %s interface=%s current=%s mode=%#x result=%d AN=%#x STATUS=%#x CTRL0=%#x CTRL2=%#x CTRL4=%#x CLOCK=%#x\n",
+		    event, phy_modes(interface), phy_modes(pp->phy_interface),
+		    mode, result, mvreg_read(pp, MVNETA_GMAC_AUTONEG_CONFIG),
+		    mvreg_read(pp, MVNETA_GMAC_STATUS),
+		    mvreg_read(pp, MVNETA_GMAC_CTRL_0),
+		    mvreg_read(pp, MVNETA_GMAC_CTRL_2),
+		    mvreg_read(pp, MVNETA_GMAC_CTRL_4),
+		    mvreg_read(pp, MVNETA_GMAC_CLOCK_DIVIDER));
+}
+
