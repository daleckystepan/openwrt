Subject: [PATCH] net: dsa: mv88e6xxx: expose MOX CPU port egress counters

Expose switch0 port 9 MIB egress counters through debugfs so they can
be compared with eth1 RX counters during traffic. This is a read-only
temporary diagnostic, not a fix.

---
 drivers/net/dsa/mv88e6xxx/chip.c | 44 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 43 insertions(+), 1 deletion(-)

--- a/drivers/net/dsa/mv88e6xxx/chip.c
+++ b/drivers/net/dsa/mv88e6xxx/chip.c
@@ -13,5 +13,6 @@
 #include <linux/bitfield.h>
 #include <linux/delay.h>
+#include <linux/debugfs.h>
 #include <linux/dsa/mv88e6xxx.h>
 #include <linux/etherdevice.h>
 #include <linux/ethtool.h>
@@ -30,5 +31,6 @@
 #include <linux/property.h>
 #include <linux/netdevice.h>
 #include <linux/gpio/consumer.h>
+#include <linux/seq_file.h>
 #include <linux/phylink.h>
 #include <net/dsa.h>
@@ -1392,8 +1394,39 @@ static void mv88e6xxx_get_ethtool_stats(struct dsa_switch *ds, int port,
 		return;

 	mv88e6xxx_get_stats(chip, port, data);
 }

+static int mv88e6xxx_mox_cpu_port_stats(struct seq_file *s, void *data)
+{
+	struct dsa_switch *ds = dev_get_drvdata(s->private);
+	struct mv88e6xxx_chip *chip = ds->priv;
+	u64 octets, unicast, broadcasts, multicasts;
+	int err;
+
+	mv88e6xxx_reg_lock(chip);
+	err = chip->info->ops->stats_snapshot(chip, 9);
+	if (!err) {
+		octets = _mv88e6xxx_get_ethtool_stat(chip,
+			&mv88e6xxx_hw_stats[MV88E6XXX_HW_STAT_ID_out_octets], 9, 0, 0);
+		unicast = _mv88e6xxx_get_ethtool_stat(chip,
+			&mv88e6xxx_hw_stats[MV88E6XXX_HW_STAT_ID_out_unicast], 9, 0, 0);
+		broadcasts = _mv88e6xxx_get_ethtool_stat(chip,
+			&mv88e6xxx_hw_stats[MV88E6XXX_HW_STAT_ID_out_broadcasts], 9, 0, 0);
+		multicasts = _mv88e6xxx_get_ethtool_stat(chip,
+			&mv88e6xxx_hw_stats[MV88E6XXX_HW_STAT_ID_out_multicasts], 9, 0, 0);
+	}
+	mv88e6xxx_reg_unlock(chip);
+	if (err)
+		return err;
+	if (octets == U64_MAX || unicast == U64_MAX ||
+	    broadcasts == U64_MAX || multicasts == U64_MAX)
+		return -EIO;
+
+	seq_printf(s, "port=9 out_octets=%llu out_unicast=%llu out_broadcasts=%llu out_multicasts=%llu\n",
+		   octets, unicast, broadcasts, multicasts);
+	return 0;
+}
+
 static void mv88e6xxx_get_eth_mac_stats(struct dsa_switch *ds, int port,
 					struct ethtool_eth_mac_stats *mac_stats)
 {
@@ -7199,6 +7232,7 @@ static int mv88e6xxx_register_switch(struct mv88e6xxx_chip *chip)
 {
 	struct device *dev = chip->dev;
 	struct dsa_switch *ds;
+	int err;

 	ds = devm_kzalloc(dev, sizeof(*ds), GFP_KERNEL);
 	if (!ds)
@@ -7222,7 +7256,15 @@ static int mv88e6xxx_register_switch(struct mv88e6xxx_chip *chip)

 	dev_set_drvdata(dev, ds);

-	return dsa_register_switch(ds);
+	err = dsa_register_switch(ds);
+	if (err)
+		return err;
+	if (of_machine_is_compatible("cznic,turris-mox") &&
+	    of_device_is_compatible(dev->of_node,
+				    "marvell,turris-mox-mv88e6190"))
+		debugfs_create_devm_seqfile(dev, "mox_cpu_port9", NULL,
+					    mv88e6xxx_mox_cpu_port_stats);
+	return 0;
 }

 static void mv88e6xxx_unregister_switch(struct mv88e6xxx_chip *chip)
